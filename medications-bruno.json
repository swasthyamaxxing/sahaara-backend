{
  "name": "Sahaara Backend - Medications",
  "version": "1.0",
  "presets": [
    {
      "name": "localhost",
      "default": true,
      "values": [
        {
          "name": "baseUrl",
          "value": "http://127.0.0.1:8000"
        }
      ]
    }
  ],
  "collections": [
    {
      "name": "Medications",
      "items": [
        {
          "name": "Create Medication",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/medications/store",
            "body": {
              "mode": "json",
              "json": "{\n  \"patient_id\": 1,\n  \"medicine_name\": \"Paracetamol\",\n  \"purpose\": \"Pain relief\",\n  \"dosage\": \"500mg\",\n  \"frequency\": \"Twice daily\",\n  \"times\": [\"08:00\", \"20:00\"],\n  \"start_date\": \"2026-07-29\",\n  \"end_date\": \"2026-08-05\",\n  \"instructions\": \"Take with food\",\n  \"prescribing_doctor\": \"Dr. Singh\",\n  \"status\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Get Active Medications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/medications/1"
          }
        },
        {
          "name": "Update Medication",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/medications/1",
            "body": {
              "mode": "json",
              "json": "{\n  \"medicine_name\": \"Paracetamol\",\n  \"purpose\": \"Pain relief\",\n  \"dosage\": \"1000mg\",\n  \"frequency\": \"Twice daily\",\n  \"times\": [\"08:00\", \"20:00\"],\n  \"start_date\": \"2026-07-29\",\n  \"end_date\": \"2026-08-05\",\n  \"instructions\": \"Take with food\",\n  \"prescribing_doctor\": \"Dr. Singh\",\n  \"status\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Delete Medication",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/medications/1"
          }
        }
      ]
    }
  ]
}
